<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Permits local LAN HTTP connections (e.g., http://192.168.x.x:11434 or http://10.0.2.2:11434) for Ollama and local webhooks -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
